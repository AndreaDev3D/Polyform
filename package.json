{
  "name": "polyform",
  "version": "0.6.0",
  "description": "Polyform — a local-first, self-contained, open-source vector design tool for the desktop.",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "MIT",
  "author": "Polyform Contributors",
  "homepage": "https://github.com/polyform/polyform",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "test:e2e": "node scripts/e2e-text.mjs",
    "test:mcp": "node scripts/mcp-probe.mjs",
    "test:cli": "node scripts/cli-test.mjs",
    "cli": "electron out/main/index.js",
    "build:wasm": "node scripts/build-wasm.mjs",
    "bench": "vitest bench --run",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@msgpack/msgpack": "^3.0.0",
    "@sparkjsdev/spark": "^2.1.0",
    "onnxruntime-web": "^1.27.0",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.71",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.polyform.app",
    "productName": "Polyform",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    }
  }
}
