// Polyform scene graph — FlatBuffers target schema, tracking document
// schema v4 (v0.5). This is the source of truth for the planned
// FlatBuffers migration (ADR-004) and the reference object model for the
// v0.4 Rust core (see V0.4-Porting-Plan.md). scene.bin currently ships as a
// MessagePack envelope: bytes "PFRM" + format byte 0x01 + msgpack payload
// { schemaVersion, savedAt, doc }.

namespace Polyform.Schema;

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum NodeType : byte {
  Frame,
  Group,
  Boolean,
  Rectangle,
  Ellipse,
  Line,
  Polygon,
  Star,
  VectorPath,
  Text,
  Component,   // v3: main component (frame semantics + provenance)
  Instance,    // v3: materialized instance of a component
  Model3d      // v4: 3D model composited as a 2D node (ADR-020)
}

// v4: container format of a MODEL3D asset.
enum Model3dFormat : byte {
  Glb,
  Ply,
  Spz,
  Splat,
  Ksplat,
  Sog
}

// v4: procedural lighting environment (splat formats ignore it — their
// radiance is baked into the capture).
enum LightingPreset : byte {
  Studio,
  Neutral,
  Dramatic,
  None
}

// v4: orbit camera. Framing is automatic (the model's bounding sphere is
// fitted to the node box), so distance is a multiplier of that fit.
struct ModelPose {
  yaw: float;        // degrees around the up axis
  pitch: float;      // degrees above/below the equator, clamped to +-89.9
  distance: float;   // multiplier of the auto-framed distance
  fov: float;        // vertical field of view, degrees
}

enum BooleanOp : byte { Union, Subtract, Intersect, Exclude }
enum StrokeAlign : byte { Center, Inside, Outside }
enum PaintType : byte { Solid, GradientLinear, GradientRadial, Image }
enum ImageScaleMode : byte { Fill, Fit, Tile, Stretch }
enum LayoutMode : byte { None, Horizontal, Vertical }
enum AxisSizing : byte { Fixed, Hug }
enum CounterAlign : byte { Min, Center, Max }
enum TextAlignH : byte { Left, Center, Right }
enum TextAlignV : byte { Top, Center, Bottom }
enum TextAutoResize : byte { WidthAndHeight, Height, None }
enum EffectType : byte { DropShadow, InnerShadow, LayerBlur, BackgroundBlur } // v2: +Inner/+Background
enum WindingRule : byte { NonZero, EvenOdd }
enum GuideAxis : byte { X, Y }                                                // v2
enum Constraint : byte { Min, Max, Center, Stretch, Scale }                   // v2

// ---------------------------------------------------------------------------
// Value types
// ---------------------------------------------------------------------------

struct Vec2 {
  x: float;
  y: float;
}

struct Color {
  r: float;
  g: float;
  b: float;
  a: float;
}

table GradientStop {
  position: float;
  color: Color;
}

// v2: non-destructive crop rect, normalized to the source image (0..1).
table ImageCrop {
  x: float;
  y: float;
  w: float;
  h: float;
}

// v2: non-destructive adjustments, each -1..1 (0 = neutral).
table ImageAdjust {
  exposure: float;
  contrast: float;
  saturation: float;
}

table Paint {
  type: PaintType;
  visible: bool = true;
  opacity: float = 1.0;
  color: Color;               // Solid
  stops: [GradientStop];      // Gradients
  start: Vec2;                // Gradient handles (normalized node space)
  end: Vec2;
  asset_hash: string;         // Image (SHA-256 in assets/)
  scale_mode: ImageScaleMode; // Image
  crop: ImageCrop;            // Image, optional (v2)
  adjust: ImageAdjust;        // Image, optional (v2)
}

table Effect {
  type: EffectType;
  visible: bool = true;
  color: Color;   // DropShadow / InnerShadow
  offset: Vec2;   // DropShadow / InnerShadow
  blur: float;    // shadow blur, or LayerBlur/BackgroundBlur radius
}

table VectorVertex {
  id: uint32;
  x: float;
  y: float;
}

table VectorEdge {
  id: uint32;
  v0: uint32;
  v1: uint32;
  has_cp0: bool = false;
  cp0: Vec2;
  has_cp1: bool = false;
  cp1: Vec2;
}

table VectorNetwork {
  vertices: [VectorVertex];
  edges: [VectorEdge];
}

table AutoLayout {
  mode: LayoutMode = None;
  gap: float;
  padding_top: float;
  padding_right: float;
  padding_bottom: float;
  padding_left: float;
  counter_align: CounterAlign = Min;
  primary_sizing: AxisSizing = Fixed;
  counter_sizing: AxisSizing = Fixed;
}

table CornerRadius {
  tl: float;
  tr: float;
  br: float;
  bl: float;
}

// v3: references into the document's shared styles (applied-by-reference).
table StyleRefs {
  fill: string;
  text: string;
  effect: string;
}

// v3: one overridden-property set of an instance, keyed by the component
// descendant's id. Values are property patches (encoded as a nested map in
// the MessagePack envelope; FlatBuffers will carry them as msgpack bytes
// until override addressing is finalized alongside variants).
table InstanceOverride {
  source_id: string (key);
  props_msgpack: [ubyte];
}

// v3: provenance of a component imported from a local library file.
table LibraryOrigin {
  library_path: string;
  component_id: string;
  imported_at: string;
}

// ---------------------------------------------------------------------------
// Nodes
// ---------------------------------------------------------------------------

table Node {
  id: string (key);
  node_type: NodeType;
  name: string;
  visible: bool = true;
  locked: bool = false;
  opacity: float = 1.0;
  blend_mode: string;
  x: float;
  y: float;
  width: float;
  height: float;
  rotation: float;
  fills: [Paint];
  strokes: [Paint];
  stroke_weight: float = 1.0;
  stroke_align: StrokeAlign = Inside;
  stroke_dash: [float];
  effects: [Effect];
  children: [string];              // child node ids, bottom -> top

  // v2 additions
  constraints_h: Constraint = Min; // relative to parent frame
  constraints_v: Constraint = Min;
  is_mask: bool = false;           // clips siblings above it in its container
  style_refs: StyleRefs;

  // Type-specific fields
  corner_radius: CornerRadius;      // Frame-likes / Rectangle
  clips_content: bool = true;       // Frame-likes
  layout: AutoLayout;               // Frame-likes
  boolean_op: BooleanOp;            // Boolean
  point_count: uint16;              // Polygon / Star
  inner_ratio: float;               // Star
  network: VectorNetwork;           // VectorPath
  winding_rule: WindingRule;        // VectorPath
  characters: string;               // Text
  font_family: string;              // Text
  font_weight: uint16;              // Text
  italic: bool = false;             // Text
  font_size: float;                 // Text
  line_height: float;               // Text (multiplier)
  letter_spacing: float;            // Text (px)
  text_align_h: TextAlignH;         // Text
  text_align_v: TextAlignV;         // Text
  auto_resize: TextAutoResize;      // Text

  // v3 additions (Component / Instance / materialized copies)
  source_id: string;                // materialized copy -> component descendant
  component_id: string;             // Instance -> its component
  overrides: [InstanceOverride];    // Instance
  synced_hash: string;              // Instance sync cache (engine-internal)
  origin: LibraryOrigin;            // Component imported from a library
  description: string;              // Component

  // v4 additions (Model3d — ADR-020)
  model_asset_hash: string;         // Model3d -> assets/<sha256>.<ext>
  model_format: Model3dFormat;      // Model3d
  model_camera: ModelPose;          // Model3d
  model_lighting: LightingPreset;   // Model3d
  model_upright: bool = true;       // Model3d (splat captures are Y-down)
}

// ---------------------------------------------------------------------------
// Document (v2: pages/guides/styles; v3: libraries)
// ---------------------------------------------------------------------------

table Guide {
  axis: GuideAxis;
  pos: float;
}

table PageViewport {
  x: float;
  y: float;
  zoom: float;
}

table Page {
  id: string (key);
  name: string;
  root_ids: [string];   // z-order, bottom -> top
  guides: [Guide];
  viewport: PageViewport;
}

table ColorStyle {
  id: string (key);
  name: string;
  paint: Paint;
}

table TextStyleProps {
  font_family: string;
  font_weight: uint16;
  italic: bool = false;
  font_size: float;
  line_height: float;
  letter_spacing: float;
}

table TextStyle {
  id: string (key);
  name: string;
  props: TextStyleProps;
}

table EffectStyle {
  id: string (key);
  name: string;
  effects: [Effect];
}

table DocumentStyles {
  colors: [ColorStyle];
  texts: [TextStyle];
  effects: [EffectStyle];
}

table AttachedLibrary {
  path: string;         // absolute path of the library's .poly bundle
  name: string;
  attached_at: string;
}

table SceneGraph {
  schema_version: uint32;   // 4 as of v0.5 (v1: single-page; v2: +pages/styles/constraints/effects; v3: +components/libraries; v4: +MODEL3D nodes)
  nodes: [Node];
  pages: [Page];
  active_page_id: string;
  styles: DocumentStyles;
  libraries: [AttachedLibrary];
}

root_type SceneGraph;
